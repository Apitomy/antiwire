<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schema module shell (TASK-2). Empty: reserves com.squareup.wire.schema only, no
  functionality, no parity claim. OPEN-2 fixed boundary: schema depends on runtime and the
  two stay independently consumable.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.apitomy</groupId>
    <artifactId>antiwire-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>wire-schema-java</artifactId>

  <name>antiwire wire-schema-java (schema module)</name>
  <description>Pure-Java port of the Wire schema model, parser and linker.</description>

  <dependencies>
    <dependency>
      <groupId>io.apitomy</groupId>
      <artifactId>wire-runtime-java</artifactId>
    </dependency>

    <!-- TASK-13 adaptation: upstream wire-schema's jvmTest suite depends on
         com.google.protobuf:protobuf-java (4.36.1 at the pin, gradle/libs.versions.toml) so
         SchemaEncoderTest can parse encoded descriptors with FileDescriptorProto.parseFrom;
         this port mirrors that test-scoped dependency for the translated SchemaEncoderFullTest. -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>4.36.1</version>
      <scope>test</scope>
    </dependency>

    <!-- TASK-33.5: an in-memory java.nio FileSystem for the JdkSchemaLoader.forFileSystem
         route tests. Latest release per Maven Central (maven-metadata.xml, checked 2026-10-29);
         test scope only, so DEC-4's production Kotlin ban and the classpath origin check are
         untouched (guava arrives test-scoped with it). -->
    <dependency>
      <groupId>com.google.jimfs</groupId>
      <artifactId>jimfs</artifactId>
      <version>1.3.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
    <build>
      <plugins>
        <!-- Shares the test utilities (SchemaBuilder, TestFiles) with wire-java-generator
             the way upstream's wire-test-utils module does; consumed with type test-jar. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <executions>
            <execution>
              <goals><goal>test-jar</goal></goals>
            </execution>
          </executions>
        </plugin>
        <!-- LICENSE and NOTICE into the tests jar too (DEC-18 publishes it), mirroring the
             parent's license-notice execution. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <executions>
            <execution>
              <id>license-notice-tests</id>
              <phase>process-test-resources</phase>
              <goals>
                <goal>copy-resources</goal>
              </goals>
              <configuration>
                <outputDirectory>${project.build.testOutputDirectory}/META-INF</outputDirectory>
                <resources>
                  <resource>
                    <directory>${project.basedir}/..</directory>
                    <includes>
                      <include>LICENSE</include>
                      <include>NOTICE</include>
                    </includes>
                  </resource>
                </resources>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <!-- TASK-21 release plumbing: attach -sources and -javadoc jars at package for this
             shipped module. Versions and the doclint scoping live in the parent
             pluginManagement. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <executions>
            <execution>
              <id>attach-sources</id>
              <goals>
                <goal>jar-no-fork</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <executions>
            <execution>
              <id>attach-javadocs</id>
              <goals>
                <goal>jar</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </build>

</project>
