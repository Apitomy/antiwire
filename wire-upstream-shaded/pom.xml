<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.apitomy</groupId>
    <artifactId>antiwire-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>wire-upstream-shaded</artifactId>

  <name>antiwire upstream wire-runtime (relocated, test fixture)</name>
  <description>
    Test fixture only, never published: upstream com.squareup.wire:wire-runtime-jvm 7.1.0 with
    com.squareup.wire relocated to io.apitomy.antiwire.parity.wire and okio relocated to
    io.apitomy.antiwire.parity.okio, so the port's tests can run both implementations side by
    side on one classpath and assert byte-for-byte and exception-for-exception parity. The
    relocated jar exists only from the package phase on, so downstream parity tests require
    mvn verify, not mvn test.
  </description>

  <!-- This module exists to hold a compile-scope external dependency for the shade step; the
       zero-dependency invariant applies to the shipped artifacts, not to this fixture. -->
  <properties>
    <enforcer.skip>true</enforcer.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.squareup.wire</groupId>
      <artifactId>wire-runtime-jvm</artifactId>
      <version>7.1.0</version>
    </dependency>
    <!-- TASK-39: wire-schema-jvm joins the fixture so the dual-run identity harness can run
         real Wire's schema layer next to the port. The existing com.squareup.wire relocation
         places its classes under io.apitomy.antiwire.parity.wire.schema.*; kotlin-stdlib
         stays the one unrelocated shared library (comment above), and the four schema classes
         referencing kotlin/reflect use only kotlin.reflect.KClass as a stored constructor
         parameter, which ships in kotlin-stdlib: no kotlin-reflect dependency is needed. -->
    <dependency>
      <groupId>com.squareup.wire</groupId>
      <artifactId>wire-schema-jvm</artifactId>
      <version>7.1.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <!-- kotlin-stdlib must not be embedded: it is unrelocated (wire calls it by its
                   real package), and the consuming module already declares it as a direct
                   test-scope dependency, so embedding would only duplicate classes on the
                   surefire classpath and repack 1.7 MB per build for nothing. -->
              <artifactSet>
                <excludes>
                  <exclude>org.jetbrains.kotlin:*</exclude>
                  <exclude>org.jetbrains:annotations</exclude>
                </excludes>
              </artifactSet>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
              <relocations>
                <relocation>
                  <pattern>com.squareup.wire</pattern>
                  <shadedPattern>io.apitomy.antiwire.parity.wire</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>okio</pattern>
                  <shadedPattern>io.apitomy.antiwire.parity.okio</shadedPattern>
                </relocation>
                <!-- TASK-39: wire-schema-jvm's graph brings guava, kotlinpoet and the
                     palantir javapoet; each is relocated into the fixture namespace so
                     nothing unrelocated but kotlin-stdlib reaches a consumer classpath and
                     no relocation can collide with the port's own dependency set. (The
                     port's own com.squareup:javapoet is NOT in this graph: the shaded jar
                     carries zero com/squareup/javapoet entries.) -->
                <relocation>
                  <pattern>com.google.common</pattern>
                  <shadedPattern>io.apitomy.antiwire.parity.guava</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.squareup.kotlinpoet</pattern>
                  <shadedPattern>io.apitomy.antiwire.parity.kotlinpoet</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.palantir.javapoet</pattern>
                  <shadedPattern>io.apitomy.antiwire.parity.javapoet</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <!-- stale original-package Kotlin metadata under relocation; verified the
                         upstream jar ships kotlin_module files and no com.android.tools
                         entries, so only this exclude is needed -->
                    <exclude>META-INF/*.kotlin_module</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
