<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional Java generator module shell (TASK-2). Empty: reserves com.squareup.wire.java only,
  no functionality, no parity claim. OPEN-2 fixed boundary: the generator is optional and
  depends on schema, and carries no runtime or schema classes of its own (duplicate-class
  prevention rule 4 in docs/compatibility-matrix.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.apitomy</groupId>
    <artifactId>antiwire-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>wire-java-generator</artifactId>

  <name>antiwire wire-java-generator</name>
  <description>Optional Java code generator and WireCompiler CLI, ported from upstream Wire 7.1.0.</description>

  <dependencies>
    <dependency>
      <groupId>io.apitomy</groupId>
      <artifactId>wire-schema-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.apitomy</groupId>
      <artifactId>wire-runtime-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.apitomy</groupId>
      <artifactId>wire-schema-java</artifactId>
      <version>${project.version}</version>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>
    <!-- Explicitly permitted pure-Java dependency of the optional generator module (OPEN-2).
         Square JavaPoet 1.13.0, not upstream Wire's palantir fork: see the javapoet.version
         property comment in the parent pom (DEC-3 Java 11 floor + proven byte-identical
         golden output). -->
    <dependency>
      <groupId>com.squareup</groupId>
      <artifactId>javapoet</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- TASK-21 release plumbing: attach -sources and -javadoc jars at package for this
           shipped module. Versions and the doclint scoping live in the parent
           pluginManagement. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
